{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoPipeline Deterministic Composition Scene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "canvas", "layers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "scene_id": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background_rgba"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "background_rgba": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 255},
          "minItems": 4,
          "maxItems": 4
        }
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "x", "y", "scale", "rotation_deg", "flip_x", "opacity", "z"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "scale": {"type": "number", "exclusiveMinimum": 0},
          "rotation_deg": {"type": "number"},
          "flip_x": {"type": "boolean"},
          "opacity": {"type": "number", "minimum": 0, "maximum": 1},
          "z": {"type": "integer"}
        }
      }
    }
  }
}
