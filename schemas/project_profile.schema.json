{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AutoPipeline Child Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "project_id",
    "content_family",
    "creative_authority_root",
    "creative_authority_refs",
    "episode_id_pattern",
    "products",
    "stage_overrides"
  ],
  "properties": {
    "profile_version": {"const": "1.0"},
    "project_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]+$"},
    "content_family": {"enum": ["STORY_EMPATHY", "OBSERVATION_SENSORY"]},
    "creative_authority_root": {"type": "string", "minLength": 1},
    "creative_authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "episode_id_pattern": {"type": "string", "minLength": 1},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "status", "aspect_ratio", "delivery"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["CAROUSEL", "VERTICAL_MOTION"]},
          "status": {"enum": ["ACTIVE", "PLANNED", "DISABLED"]},
          "aspect_ratio": {"type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"},
          "delivery": {"enum": ["SEPARATE_FRAME_FILES", "VIDEO_FILE"]}
        }
      }
    },
    "stage_overrides": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["intent", "authority_refs"],
        "properties": {
          "intent": {"type": "string", "minLength": 1},
          "authority_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
        }
      }
    }
  }
}
